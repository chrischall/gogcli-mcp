{
  "name": "gogcli-mcp-monorepo",
  "private": true,
  "version": "4.5.0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "node scripts/check-runner-gog-version.mjs && node scripts/sync-mcp-host-tools.mjs --if-configured && node scripts/run-tests.js",
    "test:workspaces": "npm test --workspaces",
    "check:runner-gog-version": "node scripts/check-runner-gog-version.mjs",
    "check:mcp-host-tools": "node scripts/sync-mcp-host-tools.mjs",
    "sync:mcp-host-tools": "node scripts/sync-mcp-host-tools.mjs --apply",
    "typecheck": "npm run typecheck --workspaces",
    "publish:all": "npm run build && npm publish --access public --workspaces"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
