{
  "name": "gogcli-mcp-monorepo",
  "private": true,
  "version": "2.21.0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@chrischall/mcp-connector": "^1.3.0",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-oauth-provider": "^0.10.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "agents": "^0.19.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "node scripts/run-tests.js",
    "test:workspaces": "npm test --workspaces",
    "test:runner": "npm test --prefix fly-gog-runner",
    "typecheck": "npm run typecheck --workspaces",
    "publish:all": "npm run build && npm publish --access public --workspaces",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:test": "vitest run --config vitest.workers.config.mts"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/sdk": "^1.30.0"
    }
  }
}
