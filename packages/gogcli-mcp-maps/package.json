{
  "name": "gogcli-mcp-maps",
  "version": "4.10.0",
  "mcpName": "io.github.chrischall/gogcli-mcp-maps",
  "description": "Trip mapping MCP server via gogcli — Google Places and Geocoding through gog maps, and trip stops as pins on a map (Google Maps shortlist links, KML/CSV in Drive for My Maps import)",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrischall/gogcli-mcp"
  },
  "type": "module",
  "bin": {
    "gogcli-mcp-maps": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "node ../../scripts/bundle.js src/index.ts dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^3.6.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.1"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "google",
    "gogcli",
    "google-maps",
    "google-places",
    "maps",
    "trip"
  ]
}
